{
  "name": "oms-solid",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Greenfield SolidJS implementation of the open-mSupply reverse spec (see ../spec).",
  "scripts": {
    "dev": "vite --port 5180",
    "build": "vite build",
    "preview": "vite preview --port 5180",
    "tokens": "node scripts/gen-tokens.ts",
    "icons": "node scripts/copy-icons.ts",
    "gen": "node scripts/gen-tokens.ts && node scripts/copy-icons.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@solidjs/router": "^0.15.3",
    "solid-js": "^1.9.5"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vite-plugin-solid": "^2.11.0",
    "vitest": "^3.0.5"
  }
}
